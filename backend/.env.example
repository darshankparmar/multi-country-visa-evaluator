# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/visa-evaluation
MONGODB_TEST_URI=mongodb://localhost:27017/visa-evaluation-test

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Evaluation Configuration
SUCCESS_CAP=85
EVALUATOR_TYPE=rule-based
REQUEST_TIMEOUT_MS=30000

# AI Service Configuration (required if EVALUATOR_TYPE=ai)
OPENAI_API_KEY=
AI_MODEL=gpt-4

# AI Evaluation Configuration
ENABLE_DOCUMENT_PARSING=true
MAX_DOCUMENT_TEXT_LENGTH=10000
PARSING_TIMEOUT=30000
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_RETRY_ATTEMPTS=2
USE_MOCK_AI=false

# Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@visaeval.com

# Security Configuration
API_KEY_LENGTH=32
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info
