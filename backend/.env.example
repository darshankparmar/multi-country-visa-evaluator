# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/visa-evaluation
MONGODB_TEST_URI=mongodb://localhost:27017/visa-evaluation-test

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Evaluation Configuration
SUCCESS_CAP=85
EVALUATOR_TYPE=rule-based
REQUEST_TIMEOUT_MS=30000

# AI Service Configuration (required if EVALUATOR_TYPE=ai)
OPENAI_API_KEY=                      # Your OpenAI API key (get from platform.openai.com)
AI_MODEL=gpt-4                       # OpenAI model: gpt-4, gpt-4-turbo, gpt-3.5-turbo

# AI Evaluation Enhancement Configuration
ENABLE_DOCUMENT_PARSING=true         # Extract text from documents (PDF, DOCX, TXT)
MAX_DOCUMENT_TEXT_LENGTH=10000       # Maximum characters per document (prevents token overflow)
PARSING_TIMEOUT=30000                # Document parsing timeout in milliseconds
AI_TEMPERATURE=0.7                   # OpenAI temperature (0-1): lower = more focused, higher = more creative
AI_MAX_TOKENS=2000                   # Maximum tokens for AI response (needs 2000+ for detailed responses)
AI_RETRY_ATTEMPTS=2                  # Number of retry attempts for OpenAI API failures
USE_MOCK_AI=false                    # Use mock AI responses for testing (no API calls, zero cost)

# Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@visaeval.com

# Security Configuration
API_KEY_LENGTH=32
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting Configuration
RATE_LIMIT_GENERAL_MAX=100                    # General API requests per window per IP
RATE_LIMIT_GENERAL_WINDOW_MS=900000           # 15 minutes in milliseconds
RATE_LIMIT_EVALUATION_MAX=10                  # Evaluation submissions per window per IP
RATE_LIMIT_EVALUATION_WINDOW_MS=3600000       # 1 hour in milliseconds
RATE_LIMIT_PARTNER_MAX=1000                   # Partner API requests per window per API key
RATE_LIMIT_PARTNER_WINDOW_MS=3600000          # 1 hour in milliseconds
RATE_LIMIT_PARTNER_EVAL_MAX=50                # Partner evaluation submissions per window per API key
RATE_LIMIT_PARTNER_EVAL_WINDOW_MS=3600000     # 1 hour in milliseconds
